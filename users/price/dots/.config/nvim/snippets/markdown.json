{
  "details": {
    "scope": "markdown,mdx",
    "prefix": "details",
    "body": [
      "<details>",
      "<summary>$1</summary>",
      "$0",
      "</details>"
    ]
  },
  "postheader": {
    "scope": "markdown,mdx",
    "prefix": "postheader",
    "body": [
      "---",
      "title: ${1:title}",
      "summary: ${2:summary}",
      "tags:",
      "  - ${3:tag}",
      "---"
    ]
  }
}
